# Google Analytics 4 measurement ID (public, safe to expose in client bundle)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Brevo API key for sending enquiry form emails (server-only, keep secret)
BREVO_API_KEY=

# Where enquiry form emails should be sent (defaults to business.email in src/lib/business.ts)
CONTACT_NOTIFY_EMAIL=

# Google Places API key for pulling real Google Reviews (server-only, keep secret)
# Needs the "Places API (New)" enabled in Google Cloud Console
GOOGLE_PLACES_API_KEY=
